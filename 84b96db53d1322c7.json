{
  "sitetag": "brazznew",
  "base": "https://brazz-new.xyz",
  "logo": "https://favicon.yandex.net/favicon/v2/brazzers.com?size=120",
  "logoNeedsLight": false,
  "newUrl": "https://brazz-new.xyz/en/new-videos/page-{page}/brazz-new/",
  "mvUrl": "https://brazz-new.xyz/en/sort-by-views/page-{page}/brazz-new/",
  "hotUrl": "https://brazz-new.xyz/en/sort-by-being-watched/page-{page}/brazz-new/",
  "searchUrl": "https://brazz-new.xyz/en/search/brazz-new/?s={q}",
  "searchReplacer": "+",
  "categoryReplacer": "-",
  "newLabel": "Nuovi",
  "mvLabel": "Più visti",
  "hotLabel": "Popolari",
  "listDiv": "article.loop-video",
  "linkSelector": "a[href*=/video/]",
  "titleSelector": null,
  "imgSelector": "img",
  "imgAttr": "data-src",
  "durationSelector": "span.duration",
  "previewApiUrl": "https://brazz-new.xyz/ajax.php?action=load_video_preview&code={code}",
  "previewApiCodeAttr": "data-post-id",
  "cookies": {},
  "forceWebView": true,
  "stream": {
    "regexes": [
      "src:\\s*\"([^\"]*m3u8\\.php\\?id=\\d+[^\"]*)\"",
      "(https?:[^\"'\\s]+\\.m3u8[^\"'\\s]*)",
      "(https?:[^\"'\\s]+\\.mp4[^\"'\\s]*)"
    ],
    "sourceSelector": "video source",
    "sourceAttr": "src",
    "iframeSelector": "iframe[src*=/player/]"
  }
}
