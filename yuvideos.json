{
  "sitetag": "yuvideos",
  "base": "https://www.yuvideos.com",
  "logo": "https://www.yuvideos.com/favicon.png",
  "newUrl": "https://www.yuvideos.com/recent/{page}/",
  "searchUrl": "https://www.yuvideos.com/search/video/?s={q}&page={page}",
  "searchReplacer": "+",
  "pageStart": 2,
  "pageStep": 1,
  "newLabel": "Nuovi",
  "listDiv": "div.cell.video",
  "linkSelector": "a[href]",
  "titleSelector": null,
  "titleStripSelector": "",
  "imgSelector": "img.thumb, img",
  "imgAttr": "src",
  "durationSelector": "div.video-duration",
  "cookies": {},
  "stream": {
    "regexes": [
      "(https?://[^\"'\\s]+\\.mp4\\?[^\"'\\s]*)",
      "(https?://[^\"'\\s]+\\.m3u8[^\"'\\s]*)",
      "(https?://[^\"'\\s]+\\.mp4[^\"'\\s]*)"
    ],
    "sourceSelector": "video source",
    "sourceAttr": "src",
    "iframeSelector": "iframe[src*=embed]"
  },
  "previewIdSelector": "img.thumb",
  "previewIdAttr": "abs:src",
  "previewIdRegex": "(.*/)[0-9]+\\.jpg",
  "previewImageTemplate": "{id}{n}.jpg",
  "previewImageCount": 8
}
