{
  "sitetag": "notfans",
  "base": "https://notfans.com",
  "logo": "https://favicon.yandex.net/favicon/v2/notfans.com?size=120",
  "newUrl": "https://notfans.com/latest-updates/{page}/",
  "mvUrl": "https://notfans.com/most-popular/{page}/",
  "hotUrl": "https://notfans.com/top-rated/{page}/",
  "searchUrl": "https://notfans.com/search/{q}/?from_videos={page}",
  "searchReplacer": "-",
  "listDiv": "div.item",
  "linkSelector": "a[href*=/videos/]",
  "titleSelector": "strong.title",
  "titleStripSelector": "",
  "imgSelector": "img.thumb, img",
  "imgAttr": "src",
  "durationSelector": null,
  "cookies": {},
  "stream": {
    "regexes": [
      "video(?:_alt)?_url\\d*\\s*:\\s*'(https?://[^']+\\.mp4[^']*)'",
      "(https?://[^\"'\\s]*/get_file/[^\"'\\s]*\\.mp4/)\\?download",
      "(https?:[^\"'\\s]+\\.m3u8[^\"'\\s]*)",
      "(https?:[^\"'\\s]+\\.mp4[^\"'\\s]*)"
    ],
    "sourceSelector": "video source",
    "sourceAttr": "src",
    "iframeSelector": null
  },
  "disablePreview": true
}
