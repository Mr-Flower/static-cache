{
  "sitetag": "xmegadrive",
  "base": "https://www.xmegadrive.com",
  "logo": "https://www.xmegadrive.com/apple-touch-icon.png",
  "newUrl": "https://www.xmegadrive.com/latest-updates/{page}/",
  "mvUrl": "https://www.xmegadrive.com/most-popular/{page}/",
  "hotUrl": "https://www.xmegadrive.com/top-rated/{page}/",
  "searchUrl": "https://www.xmegadrive.com/search/{q}/",
  "listDiv": "div.item",
  "linkSelector": "a[href*=/videos/]",
  "titleSelector": "strong.title",
  "imgSelector": "img.thumb",
  "imgAttr": "data-original",
  "durationSelector": "div.duration",
  "previewImageTemplate": "https://{id}{n}.jpg",
  "previewIdSelector": "img.thumb",
  "previewIdAttr": "data-original",
  "previewIdRegex": "//(.+/\\d+x\\d+/)",
  "previewImageCount": 5,
  "previewCountAttr": "data-cnt",
  "stream": {
    "regexes": [
      "video(?:_alt)?_url\\d*\\s*:\\s*'([^']+)'",
      "(https?://[^\"'\\s]*/get_file/[^\"'\\s]*\\.mp4/?[^\"'\\s]*)"
    ],
    "sourceSelector": "video source",
    "sourceAttr": "src",
    "iframeSelector": null
  },
  "searchReplacer": "-",
  "pageStart": 1,
  "pageStep": 1,
  "cookies": {}
}
